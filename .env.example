# NEXORA AI — Environment Configuration

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora

# -----------------------------------------------------------------------------
# RabbitMQ (Async Jobs & Events)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f
RABBITMQ_EXCHANGE=nexora.jobs

# -----------------------------------------------------------------------------
# Redis (Cache)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Rust Backend Service (Trust Plane)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=super-secret-jwt-key-for-nexora-dev-environment-12345
RUST_LOG=info,backend=debug

# -----------------------------------------------------------------------------
# Python AI Service (Extraction, NLP & Embeddings)
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
MATCH_HIGH_CONFIDENCE_THRESHOLD=0.88
MATCH_REVIEW_THRESHOLD=0.60

# -----------------------------------------------------------------------------
# Supabase Storage (Evidence & Documents)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://mock-supabase.nexora.local
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-for-dev
SUPABASE_STORAGE_BUCKET=evidence-documents

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_AI_BASE_URL=http://localhost:8000
