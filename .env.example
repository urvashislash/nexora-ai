# =============================================================================
# NEXORA AI — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# Environment & Deployment Target
# -----------------------------------------------------------------------------
ENVIRONMENT=development # development | staging | production
APP_ENV=dev
DEBUG=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector / Supabase)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora
DATABASE_POOL_SIZE=20
DATABASE_SSL_MODE=prefer # prefer | require

# -----------------------------------------------------------------------------
# RabbitMQ (Async Jobs & Events)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f
RABBITMQ_EXCHANGE=nexora.jobs
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=15000
JOB_STATE_BACKEND=redis
JOB_STATE_TTL_SECONDS=604800
JOB_LOCK_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Redis (Cache & Distributed Locks)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Rust Backend Service (Trust Plane)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-this-to-a-secure-256-bit-random-key-in-production
JWT_EXPIRATION_HOURS=24
RUST_LOG=info,backend=debug

# Rate Limiting (Rust Backend)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_CAPACITY=30
RATE_LIMIT_SENSITIVE_PER_MINUTE=30

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_HSTS=true
CONTENT_SECURITY_POLICY="default-src 'self'; frame-ancestors 'none';"

# -----------------------------------------------------------------------------
# Python AI Service (Extraction, NLP & Embeddings)
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BACKEND=auto
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_BATCH_SIZE=64
VECTOR_RETRIEVAL_LIMIT=50

# Matching Policy Thresholds
MATCH_HIGH_CONFIDENCE_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.60
MATCH_REJECTION_THRESHOLD=0.40
MATCH_MIN_AUTO_LINK_GAP=0.08
MATCH_MIN_AUTO_LEXICAL_SCORE=0.55
MATCH_MIN_EXTRACTION_CONFIDENCE=0.70
MATCH_POLICY_VERSION=construction-v1

# Media Parsing & Upload Security
OCR_LANGUAGE=eng
OCR_DPI=300
ASR_MODEL=small.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
MAX_UPLOAD_BYTES=52428800 # 50 MB
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/plain,image/jpeg,image/png,audio/mpeg,audio/wav

# Rate Limiting (AI Service)
AI_RATE_LIMIT_EXTRACT_PER_MIN=60
AI_RATE_LIMIT_EMBED_PER_MIN=100
AI_RATE_LIMIT_PIPELINE_PER_MIN=30

# -----------------------------------------------------------------------------
# Supabase Cloud Project
# -----------------------------------------------------------------------------
SUPABASE_URL=https://vitxgshrjpyvczidzvto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=evidence-documents

# -----------------------------------------------------------------------------
# Audit Retention & Governance
# -----------------------------------------------------------------------------
AUDIT_LOG_HOT_RETENTION_DAYS=90
AUDIT_LOG_COLD_RETENTION_YEARS=7
ENABLE_AUDIT_LEGAL_HOLD=true

# -----------------------------------------------------------------------------
# Frontend Application (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://vitxgshrjpyvczidzvto.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_ENV=development
