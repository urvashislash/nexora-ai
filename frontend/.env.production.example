# =============================================================================
# NEXORA AI — Frontend Production Deployment Environment Example
# =============================================================================
# Set these variables in your hosting provider's dashboard (e.g. Vercel, Netlify,
# Cloudflare Pages, Render) or in `.env.production` during the build step.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Rust Trust Plane API (Production Backend URL)
# -----------------------------------------------------------------------------
# URL of your deployed Rust backend service (Render / Fly.io / AWS ECS)
VITE_API_URL="https://nexora-backend.onrender.com"

# -----------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# -----------------------------------------------------------------------------
# Supabase project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL="https://vitxgshrjpyvczidzvto.supabase.co"

# Supabase Public Anon JWT Key (safe for frontend bundle)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 3. Environment Identifier
# -----------------------------------------------------------------------------
VITE_APP_ENV="production"
