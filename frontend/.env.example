# =============================================================================
# NEXORA AI — Environment Variables Example
# =============================================================================
# Copy this file to `.env` for production, `.env.local` for local development.

# Supabase Connection URL (API Endpoint)
# For local dev: http://localhost:54321
# For production: https://<project-ref>.supabase.co
VITE_SUPABASE_URL="http://localhost:54321"

# Supabase Anonymous Key (Public)
# Can be found in Supabase Dashboard -> Settings -> API
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# (Optional) Application Environment Mode
# VITE_APP_ENV="development" # or "production", "staging"
