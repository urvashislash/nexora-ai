# =============================================================================
# NEXORA AI — Frontend Environment Variables Example
# =============================================================================
# Copy this file to:
#   - `.env.local` for local development
#   - `.env.production` or configure as Environment Variables in Vercel / Netlify / Cloudflare Pages for deployment
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Rust Trust Plane Backend API
# -----------------------------------------------------------------------------
# Local Dev:   http://localhost:3000
# Production:  https://nexora-backend.onrender.com (or your custom backend domain)
VITE_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. Supabase Cloud / Local Database
# -----------------------------------------------------------------------------
# Local Dev:   http://localhost:54321
# Production:  https://<project-ref>.supabase.co (e.g. https://vitxgshrjpyvczidzvto.supabase.co)
VITE_SUPABASE_URL="http://localhost:54321"

# Supabase Anonymous Key (Public Client Key)
# Found in: Supabase Dashboard -> Project Settings -> API & Database -> Project API keys (anon / public)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 3. Application Configuration (Optional)
# -----------------------------------------------------------------------------
# Environment mode: development | staging | production
VITE_APP_ENV="development"
