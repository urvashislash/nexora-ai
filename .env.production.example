# =============================================================================
# NEXORA AI — Production Environment Configuration (.env.production)
# =============================================================================

# -----------------------------------------------------------------------------
# General / Node / Rust Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
RUST_LOG=info,backend=info,tower_http=info
RUST_BACKTRACE=1

# -----------------------------------------------------------------------------
# Database (Supabase Cloud PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_production_db_password
POSTGRES_DB=postgres
POSTGRES_HOST=db.vitxgshrjpyvczidzvto.supabase.co
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/postgres?sslmode=require&pool_max_conns=20

# -----------------------------------------------------------------------------
# Supabase API & Auth Keys (Cloud)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://vitxgshrjpyvczidzvto.supabase.co
SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=evidence-documents

# -----------------------------------------------------------------------------
# RabbitMQ (Production Message Broker / CloudAMQP)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq.production.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=nexora_worker
RABBITMQ_PASSWORD=your_secure_rabbitmq_password
RABBITMQ_URL=amqps://nexora_worker:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5671/%2f
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=15000

# -----------------------------------------------------------------------------
# Redis (Production Caching & Distributed Locks)
# -----------------------------------------------------------------------------
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=rediss://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# -----------------------------------------------------------------------------
# Backend API Service (Rust / Axum)
# -----------------------------------------------------------------------------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
AI_SERVICE_URL=http://ai_service:8000
JWT_SECRET=your_production_jwt_signing_secret_min_32_chars

# -----------------------------------------------------------------------------
# AI Extraction & Matching Service (Python / FastAPI)
# -----------------------------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ALLOW_DOWNLOAD=false
PRELOAD_EMBEDDINGS_PATH=/app/models/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Frontend Service (Vite + Nginx)
# -----------------------------------------------------------------------------
VITE_API_URL=https://api.nexora.ai
VITE_SUPABASE_URL=https://vitxgshrjpyvczidzvto.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_key
