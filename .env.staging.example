# =============================================================================
# NEXORA AI — Staging Environment Configuration (.env.staging)
# =============================================================================

NODE_ENV=staging
RUST_LOG=debug,backend=debug,tower_http=debug
RUST_BACKTRACE=1

# Database (Supabase Staging / Cloud DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_staging_supabase_db_password
POSTGRES_DB=postgres
POSTGRES_HOST=db.staging.supabase.co
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/postgres?sslmode=require

# Supabase Staging API
SUPABASE_URL=https://staging.supabase.co
SUPABASE_ANON_KEY=your_staging_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=evidence-documents

# RabbitMQ Staging
RABBITMQ_HOST=rabbitmq.staging.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@${RABBITMQ_HOST}:5672/%2f
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=5000

# Redis Staging
REDIS_HOST=redis.staging.internal
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:6379/0

# Services
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
AI_SERVICE_URL=http://ai_service:8000
AI_PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ALLOW_DOWNLOAD=true

# Frontend
VITE_API_URL=https://staging-api.nexora.ai
VITE_SUPABASE_URL=https://staging.supabase.co
VITE_SUPABASE_ANON_KEY=your_staging_supabase_anon_key
